  385          // ==========================================
  386          void judge_roundabout_dir(void)
  387          {
  388   1          int r;
  389   1          uint16 left_lost_cnt = 0;
  390   1          uint16 right_lost_cnt = 0;
  391   1          
  392   1          // 获取屏幕中线坐标 (假设宽度是188，中线就是94)
  393   1          int half_w = MT9V03X_W / 2; 
  394   1      
  395   1          if (roundabout_state > 0) return;
  396   1      
  397   1          // 1. 扫描中上部区域，统计左右两侧的“丢线（贴边）”行数
  398   1          for (r = 30; r < MT9V03X_H - 15; r++) {
  399   2              if (left_line_list[r] <= 5) {
  400   3                  left_lost_cnt++;
  401   3              }
  402   2              if (right_line_list[r] >= MT9V03X_W - 6) { 
  403   3                  right_lost_cnt++;
  404   3              }
  405   2          }
  406   1      
  407   1          island_dir = 0; // 默认为无环岛
  408   1      
  409   1          /* ==========================================
  410   1           * 【判断左环岛】
  411   1           * 基础条件：左边大面积丢线，且比右边多。
  412   1           * 防伪条件：取画面中上部(Y=50)作为参考。右边线必须坚守在右半区！
  413   1           * ========================================== */
  414   1          if (left_lost_cnt > 15 && left_lost_cnt > right_lost_cnt + 10) {
  415   2              
  416   2              // 【核心绝杀】：如果是在左急弯，右边线在 Y=50 处一定会越过中线跑到左边。
  417   2              // 我们给一点容错 (+10)，只要它越过了屏幕中线附近，就识破它是弯道！
  418   2              if (right_line_list[50] < half_w + 10) {
  419   3                  island_dir = 0; // 越界了，这是个左转弯！
  420   3              } 
  421   2              else {
  422   3                  island_dir = 1; // 右线坚守右半区，确认前方是左环岛！
  423   3              }
  424   2          }
  425   1          
  426   1          /* ==========================================
  427   1           * 【判断右环岛】(同理，镜像处理)
  428   1           * ========================================== */
  429   1          else if (right_lost_cnt > 15 && right_lost_cnt > left_lost_cnt + 10) {
  430   2              
  431   2              // 如果是右急弯，左边线在 Y=50 处会越过中线跑到右边。
  432   2              // 给一点容错 (-10)，只要左线跑到了右半区，识破为弯道。
  433   2              if (left_line_list[50] > half_w - 10) {
  434   3                  island_dir = 0; // 越界了，这是个右转弯！
  435   3              } 
  436   2              else {
  437   3                  island_dir = 0; // 右环补线流程尚未实现，先不触发环岛状态机
  438   3              }
  439   2          }
  440   1      }
