               void camara_init(void)
               {
                   ips200_init();
                   ips200_show_string(0, 0, "mt9v03x init.");
                   while(1) {
                       system_delay_ms(100);
                       if(mt9v03x_init()) ips200_show_string(0, 16, "mt9v03x reinit.");
                       else break;
                   }
                   ips200_show_string(0, 16, "init success.");
               }
               
