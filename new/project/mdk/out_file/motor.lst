   22          // 电机控制函数
   23          void set_motor_speed(int left_duty, int right_duty)
   24          {
   25   1          //right_duty = -right_duty; // 修正硬件镜像安装
   26   1      
   27   1          if(left_duty > 90) left_duty = 90;
   28   1          if(left_duty < -90) left_duty = -90;
   29   1          if(right_duty > 90) right_duty = 90;
   30   1          if(right_duty < -90) right_duty = -90;
   31   1      
   32   1          // 左后轮控制
   33   1          if(left_duty >= 0) {
   34   2              gpio_set_level(DIR_1, GPIO_HIGH);                                   
   35   2              pwm_set_duty(PWM_1, left_duty * (PWM_DUTY_MAX / 100));              
   36   2          } else {
   37   2              gpio_set_level(DIR_1, GPIO_LOW);                                    
   38   2              pwm_set_duty(PWM_1, (-left_duty) * (PWM_DUTY_MAX / 100));           
   39   2          }
   40   1      
   41   1          // 右后轮控制
   42   1          if(right_duty >= 0) {
   43   2              gpio_set_level(DIR_2, GPIO_HIGH);                                   
   44   2              pwm_set_duty(PWM_2, right_duty * (PWM_DUTY_MAX / 100));             
   45   2          } else {
   46   2              gpio_set_level(DIR_2, GPIO_LOW);                                    
   47   2              pwm_set_duty(PWM_2, (-right_duty) * (PWM_DUTY_MAX / 100));          
   48   2          }
   49   1      }


