   15          //用于初始化pid参数的函数
   16          void PID_Init(PID *pid, float p, float i, float d, int maxI, int maxOut)
   17          {
   18   1          pid->kp = p;
   19   1          pid->ki = i;
   20   1          pid->kd = d;
   21   1          pid->maxIntegral = maxI;
   22   1          pid->maxOutput = maxOut;
   23   1      }
   24          
   25          //进行一次pid计算
   26          //参数为(pid结构体,目标值,反馈值)，计算结果放在pid结构体的output成员中
   27          void PID_Calc(PID *pid, int reference, int feedback)
   28          {
   29   1          float dout;
   30   1          float pout;
   31   1          float integral_next;
   32   1          float output_next;
   33   1      
   34   1          //更新数据
   35   1          pid->lastError = pid->error; //将旧error存起来
   36   1          pid->error = (float)(reference - feedback); //计算新error
   37   1      
   38   1          dout = (pid->error - pid->lastError) * pid->kd;
   39   1          pout = pid->error * pid->kp;
   40   1      
   41   1          integral_next = pid->integral + pid->error * pid->ki;
   42   1          if(integral_next > pid->maxIntegral) integral_next = pid->maxIntegral;
   43   1          else if(integral_next < -pid->maxIntegral) integral_next = -pid->maxIntegral;
   44   1      
   45   1          output_next = pout + dout + integral_next;
   46   1      
   47   1          if(output_next > pid->maxOutput)
   48   1          {
   49   2              pid->output = pid->maxOutput;
   50   2              if(pid->error < 0.0f)
   51   2              {
   52   3                  pid->integral = integral_next;
   53   3              }
   54   2          }
   55   1          else if(output_next < -pid->maxOutput)
   56   1          {
