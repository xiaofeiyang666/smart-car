    7          #include "pid.h"
    8          #include <stdio.h>
    9          #include <math.h>
   10          //首先定义PID结构体用于存放一个PID的数据
   11          #define BASE_SPEED  20
   12          PID left_motor_speedpid = {0};             //创建一个PID结构体变量
   13          PID right_motor_speedpid = {0};            //创建一个PID结构体变量
   14          PID positionpid = {0};                     //创建一个PID结构体变量
   15          //用于初始化pid参数的函数
   16          void PID_Init(PID *pid, float p, float i, float d, int maxI, int maxOut)
   17          {
   18   1          pid->kp = p;
   19   1          pid->ki = i;
   20   1          pid->kd = d;
   21   1          pid->maxIntegral = maxI;
   22   1          pid->maxOutput = maxOut;
   23   1      }
   24          
   25          //进行一次pid计算
   26          //参数为(pid结构体,目标值,反馈值)，计算结果放在pid结构体的output成员中
   27          void PID_Calc(PID *pid, int reference, int feedback)
   28          {
   29   1          int dout;
   30   1          int pout;
   31   1      
   32   1          //更新数据
   33   1          pid->lastError = pid->error; //将旧error存起来
   34   1          pid->error = reference - feedback; //计算新error
   35   1        
   36   1      
   37   1          
   38   1          //计算微分 (现在只赋值，不声明)
   39   1          dout = (pid->error - pid->lastError) * pid->kd;
   40   1          
   41   1          //计算比例 (现在只赋值，不声明)
   42   1          pout = pid->error * pid->kp;
   43   1          
   44   1          //计算积分
   45   1          pid->integral += pid->error * pid->ki;
   46   1          
   47   1          //积分限幅
   48   1          if(pid->integral > pid->maxIntegral) pid->integral = pid->maxIntegral;
   49   1          else if(pid->integral < -pid->maxIntegral) pid->integral = -pid->maxIntegral;
   50   1          
   51   1          //计算输出
   52   1          pid->output = pout + dout + pid->integral;
   53   1          //输出限幅
   54   1          if(pid->output > pid->maxOutput) pid->output =   pid->maxOutput;
   55   1          else if(pid->output < -pid->maxOutput) pid->output = -pid->maxOutput;
   56   1      }
