   27   1      }
   28          
   29          // 速度更新函数（应该在定时器中断中被调用）
   30          void encoder_update(void)
   31          {
   32   1          left_speed_raw  = encoder_get_count(ENCODER_QUAD_1); // 读取并修正左侧方向
   33   1          right_speed_raw = -encoder_get_count(ENCODER_QUAD_2);
   34   1          left_speed =  left_speed_raw;
   35   1          right_speed = right_speed_raw;
   36   1        
   37   1          accumulated_distance += (abs(left_speed_raw) + abs(right_speed_raw)) / 2;
   38   1      
   39   1          encoder_clear_count(ENCODER_QUAD_1); // 清空计数
   40   1          encoder_clear_count(ENCODER_QUAD_2); 
   41   1      }
   42          
   43          int16 Distance_Measure(void)
   44          {
   45   1          int16 dist = accumulated_distance;
   46   1          accumulated_distance = 0; // 读完后清零，相当于测量两次调用之间的距离
   47   1          return dist;
   48   1      }
