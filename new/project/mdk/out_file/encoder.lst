   15          
   16          // 真正定义这两个速度变量的地方
   17          int16 left_speed = 0;
   18          int16 right_speed = 0;
   19          int16 left_speed_raw = 0;
   20          int16 right_speed_raw = 0;
   21          
   22          // 编码器初始化函数
   23          void encoder_init(void)
   24          {
   25   1          encoder_quad_init(ENCODER_QUAD_1, ENCODER_QUAD_1_CHA, ENCODER_QUAD_1_CHB); 
