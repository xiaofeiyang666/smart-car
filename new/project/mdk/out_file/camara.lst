                   }
                   while(mt9v03x_init()) { system_delay_ms(100); }
               
                   seekfree_assistant_interface_init(SEEKFREE_ASSISTANT_WIFI_SPI);
               #if(0 == INCLUDE_BOUNDARY_TYPE)
                   seekfree_assistant_camera_information_config(SEEKFREE_ASSISTANT_MT9V03X, mt9v03x_image[0], MT9V03X_W,
             - MT9V03X_H);
               #endif
               }
               
               void camara_task(void)
               {
                   if(mt9v03x_finish_flag)
                   {
                       mt9v03x_finish_flag = 0;
               
                       img_threshold = Ostu();
                       find_jidian();
                       image_deal();
               
                       detect_right_roundabout();
                       patch_roundabout(); 
               
                       send_left_right_ascii(left_jidian, right_jidian);
                       seekfree_assistant_camera_send();
                   }
               }
               #else
               #error "IPS200_OR_WIFI must be 0 (IPS200) or 1 (WiFi)."
               #endif


